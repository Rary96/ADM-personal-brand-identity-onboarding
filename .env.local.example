# Copia questo file in `.env.local` (gitignored) e compila i valori.
# Gli stessi 5 valori vanno impostati come Environment Variables su Vercel,
# sia in Production che in Preview.
#
# 4 su 5 si copiano IDENTICI dal progetto gemello
# (../onboarding-brand-identity/.env.local): solo GOOGLE_SHEET_ID è nuovo.

# --- Google Sheets (Service Account) ---
# Identici al gemello: la stessa Service Account può servire più fogli, basta
# condividere il nuovo foglio in modifica con questo indirizzo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# NUOVO — id del foglio dedicato a QUESTO form (sta nell'URL del foglio:
# https://docs.google.com/spreadsheets/d/<QUESTO_PEZZO>/edit).
# Il foglio deve avere un tab chiamato "Risposte", con le intestazioni di
# SHEET_HEADERS (lib/google-sheets.ts) incollate nella prima riga.
GOOGLE_SHEET_ID=

# --- Gmail SMTP (App Password) ---
# Identici al gemello: stesso mittente, stessa App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
